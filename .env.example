# Copy to .env and fill in. .env is gitignored.
# Every variable the stack reads is listed here.

# ---------- Required to run anything ----------

# Postgres connection string for totem-server.
# Local (docker compose up, see local/docker-compose.yml):
TM_DATABASE_URL=postgres://totem:totem@localhost:5432/totem?sslmode=disable

# Shared secret the SDK sends as "Authorization: Bearer <key>" and the server checks
# on POST /v1/traces. Any random string; must be identical on both sides.
TM_INGEST_KEY=dev-ingest-key-change-me

# Per-project HMAC salt used to fingerprint memory and source text.
# The SDK and the server both need the same value. Any random string.
TM_PROJECT_SALT=dev-project-salt-change-me

# Postgres the Go tests may create throwaway databases on. When it is unset,
# the tests that need a database skip.
TM_TEST_DATABASE_URL=postgres://totem:totem@localhost:5432/postgres?sslmode=disable

# ---------- Server behaviour ----------

# Address the Go server listens on.
TM_LISTEN_ADDR=:8080

# Comma-separated list of browser origins allowed to call the API.
TM_CORS_ORIGIN=http://localhost:5173

# true = read-only public demo: every non-GET API request returns 403 and
# replays cannot be started (so the public site never spends LLM money).
TM_DEMO_MODE=false

# Comma-separated tool names whose output is treated as T2 (semi-trusted)
# rather than T1 (untrusted).
TM_TRUSTED_TOOLS=lookup_contact

# Log level: debug | info | warn | error
TM_LOG_LEVEL=info

# Redact the recorded model prompt, like everything else Totem stores.
#
# It is false here because replay needs it false: a redacted prompt no longer
# contains the value the agent acted on, so the model cannot reproduce the
# decision and replay refuses to grade it. The SDK needs the matching
# redact_payloads=False. The demo sets both, and every address it handles is
# a fictional .example one.
#
# Set it to true when you point Totem at an agent handling real data, and
# accept that replay will not be able to grade those decisions.
TM_REDACT_PAYLOADS=false

# ---------- LLM (replay + demo agent only) ----------

# OpenAI key. Used by the demo agent and by server-side replay.
# Not needed to browse a recorded run, or to watch the staged attack with
# `make tour`, which answers from a fixture and calls nothing.
OPENAI_API_KEY=

# Model the demo agent and replay use.
TM_REPLAY_MODEL=gpt-4o-mini

# ---------- Dashboard (build time) ----------

# Base URL of the API the dashboard calls. Local dev default shown.
VITE_API_URL=http://localhost:8080
