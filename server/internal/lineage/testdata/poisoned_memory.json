      "run_id": "run-1",
      "at": 0,
      "attrs": { "totem.run.scope": "user:42" }
    },
    {
      "op": "source",
      "run_id": "run-1",
      "at": 1,
      "attrs": {
        "totem.source.id": "11111111-1111-4111-8111-111111111111",
        "totem.source.kind": "external_document",
        "totem.source.origin": "https://portal.acme-supplies.example/notices/october",
        "totem.hmac": "src-page-hmac",
