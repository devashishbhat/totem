      }
    },
    {
      "op": "llm.call",
      "run_id": "run-2",
      "at": 11,
      "attrs": {
        "totem.llm.call_id": "22222222-2222-4222-8222-222222222222",
        "gen_ai.request.model": "gpt-4o-mini",
        "totem.llm.in_context": [
          {
            "ref_type": "memory",
            "ref_id": "crm/memories/acme.billing_address",
            "hmac": "mem-poison-hmac",
