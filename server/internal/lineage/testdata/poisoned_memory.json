        "totem.llm.payload": "{\"model\":\"gpt-4o-mini\",\"messages\":[]}"
      }
    },
    {
      "op": "decision",
      "run_id": "run-2",
      "at": 12,
      "attrs": {
        "totem.decision.id": "33333333-3333-4333-8333-333333333333",
        "totem.decision.tool": "send_email",
        "totem.decision.side_effect": true,
        "totem.llm.call_id": "22222222-2222-4222-8222-222222222222",
        "totem.decision.args": { "to": "[EMAIL:837497]", "body": "October invoice attached." },
        "totem.decision.value_flow": [
          {
            "ref_type": "memory",
            "ref_id": "crm/memories/acme.billing_address",
            "hmac": "mem-poison-hmac",
            "arg_path": "to",
            "match": "exact"
          }
        ]
      }
